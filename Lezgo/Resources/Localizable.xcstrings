    "participantDefaultName": {
      "comment": "Name of a new member who has no saved profile yet (US-02). The placeholder is the last 4 characters of their iCloud user ID, for example \"Member 7F3A\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member %@"
          }
        }
      }
    },
    "tripMapAlertAheadOfLeader": {
      "comment": "Formation alert banner (US-06): this member has been more than 200 m ahead of the leader for 15 seconds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You Precede The Leader"
          }
        }
      }
    },
    "tripMapAlertCarAheadOfLeader": {
      "comment": "Formation alert banner (US-06) about another car ahead of the leader. The placeholder is the driver's name, for example \"Car Budi - Precede The Leader\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Car %@ - Precede The Leader"
          }
        }
      }
    },
    "tripMapAlertCarOffRoute": {
      "comment": "Formation alert banner (US-06) about another car that left the route. The placeholder is the driver's name, for example \"Car Budi - Out of The Way\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Car %@ - Out of The Way"
          }
        }
      }
    },
    "tripMapAlertOffRoute": {
      "comment": "Formation alert banner (US-06): this member has been more than 100 m from the route for 15 seconds.",
